# 复制为production.env；真实文件已被Git与Docker上下文排除。
# 在受保护部署环境注入，不能把实际值提交到GitHub。
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# URL中的密码必须按URI规则编码；主机名是Compose服务名，不能写127.0.0.1。
DATABASE_URL=postgresql://journey:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/journey
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://journey.example.com
PUBLIC_WEB_URL=https://journey.example.com
REDIS_PREFIX=journey_production
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
MCP_SERVERS=train,amap,tavily
AMAP_MAPS_API_KEY=
TAVILY_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
TOUR_GATEWAY_URL=
TOUR_GATEWAY_KEY=
