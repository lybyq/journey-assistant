# 服务默认只监听本机，完成身份模块后再规划公网部署。
HOST=127.0.0.1
# 后端端口与网页默认代理一致。
PORT=3000
# 开发允许系统自检，生产拒绝启用该未鉴权通道。
NODE_ENV=development
# 浏览器来源使用精确 Origin，不包含路径与通配符。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# 此开关只影响旧匿名/ws/chat开发自检，不控制正式智能体执行。
ENABLE_DIAGNOSTICS=true
# 真实模型配置；缺失时明确报错，不回退成固定自检答案。
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# 高德与 Tavily 的真实密钥只保留在后端，不允许使用 VITE_ 前缀。
AMAP_MAPS_API_KEY=
TAVILY_API_KEY=
# 真实存储配置也可以由.env.storage.local单独提供。
DATABASE_URL=
REDIS_URL=
# 完整身份模块需要真实数据库与缓存；本地执行pnpm storage:setup自动准备独立配置。
STORAGE_ENABLED=false
# 签名秘密至少32字节；本地初始化会自动生成，不要使用示例固定值。
AUTH_SECRET=
# 本项目与集成测试使用不同Redis前缀，不清空共享缓存。
REDIS_PREFIX=journey
# 短期访问凭据有效秒数与固定刷新会话天数。
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30

# 默认真实智能体；仅本地测试可显式切换diagnostic，生产拒绝。
CHAT_EXECUTOR=agent
# 主子代理共享预算，token缺失usage时明确使用估算。
AGENT_TIMEOUT_MS=120000
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_TOKENS=50000
# 单次输出上限；超长截断或异常协议正文会触发一次受预算约束的格式修复。
AGENT_MAX_OUTPUT_TOKENS=4096
# 空值关闭全部外部工具，缺密钥只影响对应供应商。
MCP_SERVERS=train,amap,tavily
MCP_CONNECT_TIMEOUT_MS=15000
MCP_TOOL_TIMEOUT_MS=20000
MCP_CIRCUIT_MS=30000

# 可选Amadeus授权查询；test不代表生产库存。
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# 已签约团供应商HTTPS网关（合约见TOURS.md）。
TOUR_GATEWAY_URL=
TOUR_GATEWAY_KEY=
SUPPLIER_TIMEOUT_MS=20000
# 由可信部署配置生成分享地址，不读取HTTP Host头。
PUBLIC_WEB_URL=http://127.0.0.1:5173
