{
  "name": "@journey/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && concurrently -k -n TSC,NODE \"tsc -p tsconfig.json --watch\" \"node --watch --watch-preserve-output dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "12306-mcp": "0.3.10",
    "@journey/contracts": "workspace:*",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/mcp-adapters": "2.0.1",
    "@langchain/openai": "1.7.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-ws": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/websockets": "12.3.2",
    "ajv": "8.17.1",
    "deepagents": "1.16.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "^8.1.0",
    "jose": "6.2.13",
    "langchain": "^1.5.10",
    "langsmith": "0.9.0",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.0"
  }
}
