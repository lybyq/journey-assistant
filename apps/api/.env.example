# 服务默认只监听本机，完成身份模块后再规划公网部署。
HOST=127.0.0.1
# 后端端口与网页默认代理一致。
PORT=3000
# 开发允许系统自检，生产拒绝启用该未鉴权通道。
NODE_ENV=development
# 浏览器来源使用精确 Origin，不包含路径与通配符。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# 只执行框架真实健康检查，不调用模型或外部 MCP。
ENABLE_DIAGNOSTICS=true
# 模型配置仅在后续真实运行时使用，可以暂时留空。
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# 高德与 Tavily 的真实密钥只保留在后端，不允许使用 VITE_ 前缀。
AMAP_MAPS_API_KEY=
TAVILY_API_KEY=
# 后续第二模块负责实际连接、迁移与健康检测。
DATABASE_URL=
REDIS_URL=
# 完整身份模块需要真实数据库与缓存；本地执行pnpm storage:setup自动准备独立配置。
STORAGE_ENABLED=false
# 签名秘密至少32字节；本地初始化会自动生成，不要使用示例固定值。
AUTH_SECRET=
# 本项目与集成测试使用不同Redis前缀，不清空共享缓存。
REDIS_PREFIX=journey
# 短期访问凭据有效秒数与固定刷新会话天数。
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
